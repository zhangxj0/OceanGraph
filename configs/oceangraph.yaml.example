# =============================================================================
# OceanGraph-R1 Configuration Template
# Text-Only Multi-Hop Dataset Generator
# =============================================================================
# 
# Copy this file to config.yaml and fill in your values:
#   cp configs/oceangraph.yaml.example config.yaml
#
# Model names and endpoints are intentionally isolated in configs/llm.yaml.
# Keep API keys in environment variables:
#   export PARATERA_API_KEY="your-key-here"
#   export DEEPSEEK_API_KEY="your-key-here"
# =============================================================================

framework:
  name: OceanGraph-R1
  version: 2.2.1
  agent_architecture: four_agent
  agents: [corpus, evidence, qa, verifier]

# -----------------------------------------------------------------------------
# Model configuration
# -----------------------------------------------------------------------------
llm_config_file: configs/llm.yaml

# -----------------------------------------------------------------------------
# Text-only pipeline and stage-specific model routing
# -----------------------------------------------------------------------------
pipeline:
  modality: text

# -----------------------------------------------------------------------------
# Input/Output Paths
# -----------------------------------------------------------------------------
paths:
  # Input: Either a directory of PDFs/HTML/TXT/Markdown or a pre-processed chunks file
  input_pdf_dir: data/documents          # Directory with source documents
  input_chunks_file: null                 # Or: path/to/chunks.json
  
  # Output directory for results
  output_dir: output/my_dataset

# -----------------------------------------------------------------------------
# Processing Limits
# -----------------------------------------------------------------------------
processing:
  max_pdfs: null           # null = process all, or set integer limit
  sort_by_size: true       # Process smallest files first (good for testing)
  max_chunks: null         # null = process all chunks

# -----------------------------------------------------------------------------
# QA Generation Control
# -----------------------------------------------------------------------------
qa_generation:
  num_qa_pairs: 1000       # Target number of QA pairs (null = unlimited)
  type: multihop           # Options: 'multihop', 'multimodal', 'text', 'mix'
  strict_multihop_verification: true  # Still require at least two grounded chunks
  min_supporting_chunks: 2             # Minimum distinct chunks required for accepted QA
  output_jsonl: true                   # Also save qa_multihop_pass.jsonl for dataset release
  model_selection: false               # Use deterministic prefilter; avoids one verifier call per candidate
  verification_profile: cost_efficient # One DeepSeek call checks grounding + standalone + multi-hop
  max_answer_words: 12                 # Covers multi-word scientific names while remaining EM-friendly
  max_answer_cjk_chars: 16             # Chinese answer length limit
  multihop_verification_mode: balanced # Used only when verification_profile is legacy
  max_verification_chunks: 4           # Prioritize declared evidence and cap review context/cost
  max_unknown_verdicts: 1              # Tolerate one missing/uncertain per-chunk verdict in balanced mode
  counterfactual_verification: false   # Enable only with strict mode for leave-one-out ablation audits

# -----------------------------------------------------------------------------
# Shuffling (for reproducibility)
# -----------------------------------------------------------------------------
shuffling:
  enabled: true
  seed: 42

# -----------------------------------------------------------------------------
# Embedding Configuration
# -----------------------------------------------------------------------------
embedding:
  model: bge_m3            # Text embedding model
  cache_embeddings: true
  local_files_only: false  # Set true on isolated servers with pre-cached models
  batch_size: 8            # Reduce if OOM errors
  gpus: [0]                # GPU IDs for embedding
  
  models:
    bge_m3:
      name: BAAI/bge-m3
    bge_large:
      name: BAAI/bge-large-en-v1.5
    minilm:
      name: sentence-transformers/all-MiniLM-L6-v2

# -----------------------------------------------------------------------------
# Reranker Configuration
# -----------------------------------------------------------------------------
reranker:
  default: text_embedding
  
  models:
    text_embedding:
      model_name: BAAI/bge-large-en-v1.5

# -----------------------------------------------------------------------------
# QA Correction (auto-fix failed QA pairs)
# -----------------------------------------------------------------------------
qa_correction:
  enabled: false              # Reject once; do not spend extra Qwen calls rewriting failures
  max_attempts: 0

# -----------------------------------------------------------------------------
# Context Retrieval
# -----------------------------------------------------------------------------
retrieval:
  multihop:
    max_depth: 2          # Max retrieval iterations (null = unlimited)
    max_breadth: 5         # Max search queries per iteration
    chunks_per_search: 2   # Chunks retrieved per query
    log_details: true
    chunk_addition_mode: RELATED  # or "EXPLANATORY"
  
  simple:
    method: top_k
    top_k: 20
    top_p: 0.9
    rerank_top_k: 10
    context_size: 2

# -----------------------------------------------------------------------------
# Deduplication
# -----------------------------------------------------------------------------
deduplication:
  question_similarity_threshold: 0.75
  answer_similarity:
    high: 0.95             # Exact duplicates
    medium: 0.85           # Partial overlap
    low: 0.70              # Related items
  min_community_size: 2
  alpha: 0.6               # Semantic vs lineage balance

# -----------------------------------------------------------------------------
# Parallel Processing
# -----------------------------------------------------------------------------
parallel:
  num_workers: 4           # CPU workers for document conversion
  available_gpus: [0]      # GPUs for parallel processing
  qa_max_workers: 6        # Workers for QA generation
  dedup_max_workers: 4     # Workers for deduplication

# -----------------------------------------------------------------------------
# PDF Processing (Docling)
# -----------------------------------------------------------------------------
pdf_processing:
  input_path: data/documents
  output_dir: output/markdown
  image_resolution_scale: 2.0
  num_threads: 4
  cuda_device_id: 0
  pipeline_options:
    do_picture_classification: false
    do_picture_description: false
    do_ocr: true
    do_code_enrichment: true
    do_formula_enrichment: true
    do_table_structure: true
    generate_table_images: true

# -----------------------------------------------------------------------------
# Semantic Chunking
# -----------------------------------------------------------------------------
chunking:
  window_size: 20000       # Characters per window
  overlap_size: 2000       # Overlap between windows

# -----------------------------------------------------------------------------
# Domain & Expert Role (auto-detect if null)
# -----------------------------------------------------------------------------
domain_expert:
  expert_persona: "Ocean Science Multi-Hop QA Curator"
  domain: "Ocean Science and Marine Engineering"
  use_multimodal_embeddings: false
  output_dir: output/domain_analysis

# -----------------------------------------------------------------------------
# BERTopic Configuration (for domain detection)
# -----------------------------------------------------------------------------
bertopic:
  umap:
    n_neighbors: 15
    n_components: 5
    min_dist: 0.0
    metric: cosine
    random_state: 42
  umap_2d:
    n_neighbors: 10
    n_components: 2
    min_dist: 0.0
    metric: cosine
  vectorizer:
    stop_words: english
    min_df: 2
    ngram_range: [1, 2]
  mmr:
    diversity: 0.5
  calculate_probabilities: false
  verbose: true

# -----------------------------------------------------------------------------
# Downstream training export
# -----------------------------------------------------------------------------
training_export:
  enabled: true
  split: train

# -----------------------------------------------------------------------------
# Evaluation
# -----------------------------------------------------------------------------
evaluation:
  run_evaluation: false      # Enable only after configuring optional evaluation backends
  sample_size: null          # null = evaluate all
  run_context_necessity: true
  judge_stage: verification
  embedding_backend: local
  embedding_model: BAAI/bge-m3

# -----------------------------------------------------------------------------
# FAISS Index
# -----------------------------------------------------------------------------
faiss:
  index_type: IndexFlatIP
  normalize_l2: true

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
logging:
  level: INFO

# -----------------------------------------------------------------------------
# Retry Configuration
# -----------------------------------------------------------------------------
retry:
  initial_wait: 2
  max_wait: 60
  max_attempts: 3
