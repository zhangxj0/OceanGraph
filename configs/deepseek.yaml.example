pipeline:
  modality: text

backend:
  active: OPENAI
  openai:
    url: https://api.deepseek.com/chat/completions
    llm_model: deepseek-v4-pro
    vlm_model: deepseek-v4-pro
    timeout: 300

models:
  profiles:
    generator:
      backend: OPENAI
      url: https://api.deepseek.com/chat/completions
      api_key_env: DEEPSEEK_API_KEY
      model: deepseek-v4-pro
      supports_vision: false
      temperature: 0.0
      structured_output: true
      timeout: 300
    verifier:
      backend: OPENAI
      url: https://api.deepseek.com/chat/completions
      api_key_env: DEEPSEEK_API_KEY
      model: deepseek-v4-pro
      supports_vision: false
      temperature: 0.0
      structured_output: true
      timeout: 300
  stages:
    corpus: generator
    retrieval: generator
    generation: generator
    selection: verifier
    verification: verifier
    correction: generator

rate_limiting:
  requests_per_minute: 60
  burst_size: 15

paths:
  input_pdf_dir: data/documents
  input_chunks_file: null
  output_dir: output/repro_deepseek

processing:
  max_pdfs: null
  sort_by_size: true
  max_chunks: null

parallel:
  num_workers: 1
  available_gpus: [0]
  qa_max_workers: 1
  dedup_max_workers: 1

embedding:
  model: bge_m3
  cache_embeddings: true
  local_files_only: false
  batch_size: 8
  gpus: [0]

reranker:
  default: text_embedding

retrieval:
  multihop:
    max_depth: 3
    max_breadth: 4
    chunks_per_search: 3
    chunk_addition_mode: RELATED

qa_generation:
  num_qa_pairs: 20
  type: multihop
  strict_multihop_verification: true
  min_supporting_chunks: 2
  output_jsonl: true
  counterfactual_verification: true

qa_correction:
  enabled: true
  max_attempts: 1

deduplication:
  enabled: false

evaluation:
  run_evaluation: false
  sample_size: null

faiss:
  index_type: IndexFlatIP
  normalize_l2: true
  use_gpu: false
  gpu_id: 0

shuffling:
  enabled: true
  seed: 42
