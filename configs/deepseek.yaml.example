framework:
  name: OceanGraph-R1
  version: 2.2.1
  agent_architecture: four_agent
  agents: [corpus, evidence, qa, verifier]

pipeline:
  modality: text

llm_config_file: configs/llm.yaml

paths:
  input_pdf_dir: data/documents
  input_chunks_file: null
  output_dir: output/repro_deepseek

processing:
  max_pdfs: null
  sort_by_size: true
  max_chunks: null

parallel:
  num_workers: 1
  available_gpus: [0]
  qa_max_workers: 1
  dedup_max_workers: 1

embedding:
  model: bge_m3
  cache_embeddings: true
  local_files_only: false
  batch_size: 8
  gpus: [0]

reranker:
  default: text_embedding

retrieval:
  multihop:
    max_depth: 3
    max_breadth: 4
    chunks_per_search: 3
    chunk_addition_mode: RELATED

qa_generation:
  num_qa_pairs: 20
  type: multihop
  strict_multihop_verification: true
  min_supporting_chunks: 2
  output_jsonl: true
  model_selection: false
  verification_profile: cost_efficient
  max_answer_words: 12
  max_answer_cjk_chars: 16
  counterfactual_verification: false

qa_correction:
  enabled: false
  max_attempts: 0

deduplication:
  enabled: false

training_export:
  enabled: true
  split: train

evaluation:
  run_evaluation: false
  sample_size: null

faiss:
  index_type: IndexFlatIP
  normalize_l2: true
  use_gpu: false
  gpu_id: 0

shuffling:
  enabled: true
  seed: 42
