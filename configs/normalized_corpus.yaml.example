# Reproducible profile for the normalized NOAA/NASA/Argo Markdown corpus.
# Copy to config.yaml or pass this file directly with --config.
# Model endpoints and names remain isolated in configs/llm.yaml.

framework:
  name: OceanGraph-R1
  version: 3.0.0
  agent_architecture: four_agent
  agents: [corpus, evidence, qa, verifier]

llm_config_file: configs/llm.yaml

pipeline:
  modality: text

preflight:
  check_timeout_seconds: 180
  api_probe_cache_ttl_seconds: 3600

paths:
  # Recursive discovery also accepts data/normalized/normalized after unzip.
  input_pdf_dir: data/normalized
  input_chunks_file: null
  output_dir: output/normalized_dataset

processing:
  max_pdfs: null
  sort_by_size: true
  max_chunks: null

chunking:
  window_size: 8000
  overlap_size: 800

qa_generation:
  num_qa_pairs: 120
  type: multihop
  strict_multihop_verification: true
  min_supporting_chunks: 2
  output_jsonl: true
  model_selection: false
  verification_profile: cost_efficient
  max_answer_words: 12
  max_answer_cjk_chars: 16
  multihop_verification_mode: balanced
  max_verification_chunks: 4
  max_unknown_verdicts: 1
  counterfactual_verification: false

qa_correction:
  enabled: false
  max_attempts: 0

retrieval:
  multihop:
    max_depth: 2
    max_breadth: 5
    chunks_per_search: 2
    log_details: true
    chunk_addition_mode: RELATED
  simple:
    method: top_k
    top_k: 20
    top_p: 0.9
    rerank_top_k: 10
    context_size: 2

embedding:
  model: bge_m3
  cache_embeddings: true
  local_files_only: true
  batch_size: 16
  gpus: [0]
  models:
    bge_m3:
      name: BAAI/bge-m3
    bge_large:
      name: BAAI/bge-large-en-v1.5

reranker:
  default: text_embedding
  models:
    text_embedding:
      model_name: BAAI/bge-large-en-v1.5

parallel:
  num_workers: 2
  available_gpus: [0]
  qa_max_workers: 4
  dedup_max_workers: 2

deduplication:
  enabled: false
  question_similarity_threshold: 0.75
  answer_similarity: {high: 0.95, medium: 0.85, low: 0.70}
  min_community_size: 2
  alpha: 0.6

domain_expert:
  expert_persona: Ocean Science Multi-Hop QA Curator
  domain: Ocean Science and Marine Engineering
  use_multimodal_embeddings: false
  output_dir: output/normalized_dataset/domain_analysis

training_export:
  enabled: true
  split: null
  split_ratios:
    train: 0.8
    dev: 0.1
    test: 0.1
  seed: 42

evaluation:
  run_evaluation: false
  sample_size: null
  run_context_necessity: true
  judge_stage: verification
  embedding_backend: local
  embedding_model: BAAI/bge-m3

faiss:
  index_type: IndexFlatIP
  normalize_l2: true
  use_gpu: false
  gpu_id: 0

shuffling:
  enabled: true
  seed: 42

logging:
  level: INFO

retry:
  initial_wait: 2
  max_wait: 60
  max_attempts: 3
