# v4: shared by the normal pipeline and python -m oceangraph.batch.run.
# Profiles accept either full url OR base_url (OpenAI-compatible API prefix).
# Reload happens at the next process start. See README for two-provider examples.
# OceanGraph model routing (safe to edit and commit: no API keys live here).
#
# Edit only this file when the generation or verification endpoint changes.
# Put the actual secrets in the named environment variables, for example:
#   $env:OPENAI_API_KEY = "..."

schema_version: 1

# Legacy/default route used only when a stage has no explicit profile below.
backend:
  active: OPENAI
  openai:
    url: https://llmapi.paratera.com/v1/chat/completions
    llm_model: GLM-5.3
    vlm_model: GLM-5.3
    timeout: 300

models:
  profiles:
    # GLM-5.3 always reasons. Low effort is used for corpus/retrieval/generation.
    # Documented GLM fields are passed through extra_body; enable_thinking is
    # a different provider's flag and is intentionally omitted.
    generator:
      backend: OPENAI
      base_url: https://llmapi.paratera.com/v1
      api_key_env: OPENAI_API_KEY
      model: GLM-5.3
      supports_vision: false
      temperature: 0.0
      structured_output: true
      max_output_tokens: 8192
      extra_body:
        thinking:
          type: enabled
        reasoning_effort: low
      timeout: 300

    # Independent provider example: DeepSeek official API.
    # deepseek-flash maps to V4.1-Flash-1017 as of 2026-10-20; confirm provider versions.
    verifier:
      backend: OPENAI
      base_url: https://api.deepseek.com
      api_key_env: DEEPSEEK_API_KEY
      model: deepseek-flash
      supports_vision: false
      temperature: null
      structured_output: true
      max_output_tokens: 8192
      extra_body:
        thinking:
          type: enabled
        reasoning_effort: high
      timeout: 300

  stages:
    default: generator
    corpus: generator
    retrieval: generator
    generation: generator
    selection: verifier
    verification: verifier
    correction: generator

rate_limiting:
  requests_per_minute: 60
  burst_size: 15
